# Arc testnet — get from Arc docs / Discord
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# Real Arc testnet USDC — verified via symbol()/decimals() on-chain, not guessed.
# See docs.arc.io/arc/references/contract-addresses.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Verified against docs.arc.io/arc/references/connect-to-arc.
ARC_EXPLORER_URL=https://testnet.arcscan.app
# Deployer's own address for now (BondedVault.enrolledSigner is immutable —
# this is a placeholder until CRE deploy access issues a real enclave-custodied
# key, at which point the vault needs redeploying; see FEEDBACK/CHAINLINK.md).
ENFORCER_SIGNER_ADDRESS=
# Deployer key — funds the deployment. Never commit the real value.
CRE_ETH_PRIVATE_KEY=

# Deployed contract addresses (populated after forge deploy)
BONDED_REGISTRY_ADDRESS=
BONDED_VAULT_ADDRESS=

# The Graph — copy verbatim from Subgraph Studio dashboard
GRAPH_GATEWAY_URL=
# Base URL for the DECENTRALISED Gateway, used to read third-party
# standardized subgraphs (Messari DEX-AMM). Distinct from GRAPH_GATEWAY_URL
# above, which is this project's OWN subgraph query endpoint on Studio —
# sending a Messari lookup there queries the wrong subgraph entirely.
GRAPH_GATEWAY_BASE_URL=https://gateway.thegraph.com/api
# NEVER commit GRAPH_API_KEY — lives behind CRE handlerInTee / ring encrypt
# GRAPH_API_KEY=

# Our own subgraph (indexes BondedRegistry + BondedVault events)
BONDED_SUBGRAPH_ID=

# Chainlink CRE
CRE_WORKFLOW_ID=
CRE_DON_ID=

# Enforcer software signing key (encrypted, never plaintext on disk)
# ENFORCER_SIGNING_KEY=  — DO NOT USE. Key lives in CRE handlerInTee only.

# Chainlink CRE label (matches handlerInTee secret key label)
CRE_SECRET_LABEL=bonded-secrets

# Deployed AttackToken address — used by packages/attack-corpus/harness/run.ts
ATTACK_TOKEN_ADDRESS=
