# Arc testnet — get from Arc docs / Discord
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Deployed contract addresses (populated after forge deploy)
BONDED_REGISTRY_ADDRESS=
BONDED_VAULT_ADDRESS=

# The Graph — copy verbatim from Subgraph Studio dashboard
GRAPH_GATEWAY_URL=
# NEVER commit GRAPH_API_KEY — lives behind CRE handlerInTee / ring encrypt
# GRAPH_API_KEY=

# Our own subgraph (indexes BondedRegistry + BondedVault events)
BONDED_SUBGRAPH_ID=

# Chainlink CRE
CRE_WORKFLOW_ID=
CRE_DON_ID=

# Enforcer software signing key (encrypted, never plaintext on disk)
# ENFORCER_SIGNING_KEY=  — DO NOT USE. Key lives in CRE handlerInTee only.

# Chainlink CRE label (matches handlerInTee secret key label)
CRE_SECRET_LABEL=bonded-secrets

# Deployed AttackToken address — used by packages/attack-corpus/harness/run.ts
ATTACK_TOKEN_ADDRESS=
